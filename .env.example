# Sao chép thành .env rồi sửa. Mọi biến có tiền tố CALO_.
CALO_DATABASE_URL=mysql+pymysql://calo:calo@localhost:3306/calo_khay?charset=utf8mb4

# real = chạy mô hình thật; mock = trả backend/mock/scan.json (khi chưa có model/GPU, hoặc cho frontend dev)
CALO_ENGINE=real
# cpu | 0 (GPU số 0) | bỏ trống = tự chọn
CALO_DEVICE=
CALO_USE_DINO=true
# Bật độ sâu cho cơm (nạp thêm ~1,3 GB, nên có GPU). Đã chốt: tắt mặc định, bật khi demo trên laptop GPU.
CALO_DEPTH_ENABLED=false
# Ngưỡng "Cần xác nhận"; bỏ trống = 0.75 khi có DINOv2, 0.5 khi không
CALO_FLAG_CONF=

CALO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Thư mục frontend đã build (vd. frontend/dist); có thì uvicorn phục vụ luôn tại /
CALO_FRONTEND_DIST=
CALO_BLUR_THRESHOLD=40
CALO_SCAN_TTL_HOURS=24
